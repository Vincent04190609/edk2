# Copy to .env and fill in secrets locally (do not commit .env).

# Required for real Cursor agent execution (same PC as Cursor IDE).
# Create at: https://cursor.com/dashboard/integrations
CURSOR_API_KEY=

# Optional
AIFW_CURSOR_MODEL=composer-2.5
AIFW_API_PORT=58888
AIFW_WORKTREES_ROOT=D:\SourceCode\AIFW_Fleet\.aifw-worktrees
# Comma-separated allowed repo roots (empty = any valid git dir)
# AIFW_REPO_PATH_ALLOWLIST=D:\BIOS,D:\SourceCode
AIFW_PHASE_SYNC_INTERVAL_SEC=60
AIFW_HOST_BIOS_ROOT=D:/SourceCode/AIFW_Fleet/workspace/bios_project
AIFW_HOST_DATA_DIR=D:/SourceCode/AIFW_Fleet/workspace/csv_data

# GitHub PAT (repo scope) — git push + gh pr after delivery approval
GITHUB_TOKEN=
GH_TOKEN=

# KB bind mounts for agent access (fleet mode in .cursor/kb-path-config.json)
AIFW_HOST_KB_PROJECTS_ROOT=D:/VibeCoding/Projects
AIFW_HOST_COMMON_KB_ROOT=D:/VibeCoding/Common
AIFW_TIMEZONE=Asia/Taipei
