## @file
#  Onboarding platform package — OEM features for the Onboarding BIOS project.
#
#  SPDX-License-Identifier: BSD-2-Clause-Patent
#
##
[Defines]
  DEC_SPECIFICATION              = 0x00010005
  PACKAGE_NAME                   = OnboardingPkg
  PACKAGE_GUID                   = 8A3F2C1E-9B4D-4E5F-A6C7-1D2E3F4A5B6C
  PACKAGE_VERSION                = 0.1

[Includes]
  Include

[LibraryClasses]
  OnboardingAcpiEcIoDispatchLib|Include/Library/OnboardingAcpiEcIoDispatchLib.h

[Guids]
  gOnboardingPkgTokenSpaceGuid = { 0xA1B2C3D4, 0xE5F6, 0x7890, { 0xAB, 0xCD, 0xEF, 0x01, 0x23, 0x45, 0x67, 0x89 }}

[Protocols]
  gOnboardingAcpiEcIoDispatchProtocolGuid = { 0x7C4E9A2B, 0x5D1F, 0x4A8E, { 0x9B, 0x3C, 0x2D, 0x4E, 0x5F, 0x6A, 0x7B, 0x8C }}

[PcdsFixedAtBuild]
  ## Max parameter bytes collected on port 0x62 after sub-command for cmd 0x59.
  gOnboardingPkgTokenSpaceGuid.PcdAcpiEc59MaxParamBytes|64|UINT16|0x01

[PcdsFixedAtBuild, PcdsPatchableInModule]
  gOnboardingPkgTokenSpaceGuid.PcdAcpiEcDataPort|0x62|UINT16|0x02
  gOnboardingPkgTokenSpaceGuid.PcdAcpiEcCmdStatusPort|0x66|UINT16|0x03
